<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Weekly cleanup of stale draft restore.job records (older than 7 days) -->
        <record id="ir_cron_restore_job_draft_cleanup" model="ir.cron">
            <field name="name">Texura: Cleanup Stale Restore Job Drafts</field>
            <field name="model_id" ref="model_txr_db_restore_job"/>
            <field name="state">code</field>
            <field name="code">model._cleanup_draft_orphans()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
